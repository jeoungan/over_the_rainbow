{
  "name": "over-the-rainbow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite-dev.mjs",
    "build": "tsc --noEmit && node scripts/vite-build.mjs",
    "test": "vitest run \"src/**/*.test.ts\" --environment node --globals",
    "test:watch": "vitest \"src/**/*.test.ts\" --environment node --globals",
    "e2e": "playwright test",
    "verify": "npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "phaser": "^3.90.0",
    "poly-decomp": "^0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^25.9.3",
    "@types/opentype.js": "^1.3.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
